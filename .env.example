# Copy to .env (never commit .env). Every key starts with NYAYA_.
NYAYA_ENV=local
NYAYA_LOG_LEVEL=INFO

NYAYA_POSTGRES_DSN=postgresql+asyncpg://nyaya_app:change-me@localhost:5432/nyaya
NYAYA_POSTGRES_MIGRATOR_DSN=postgresql+psycopg://nyaya_migrator:change-me@localhost:5432/nyaya

NYAYA_MONGO_URI=mongodb://localhost:27017
NYAYA_REDIS_URL=redis://localhost:6379/0
NYAYA_QDRANT_URL=http://localhost:6333
NYAYA_ELASTICSEARCH_URL=http://localhost:9200

NYAYA_S3_ENDPOINT=http://localhost:9000
NYAYA_S3_ACCESS_KEY=minioadmin
NYAYA_S3_SECRET_KEY=minioadmin
NYAYA_KAFKA_BOOTSTRAP=localhost:9092

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NYAYA_JWT_SECRET=replace-with-a-long-random-value

NYAYA_LANGSMITH_ENABLED=false
